{
	"root": false,
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
		"includes": ["**/src/**", "**/tests/**", "!**/dist"]
  },
	"linter": {
		"rules": {
			"style": {
				"noParameterAssign": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noMisleadingCharacterClass": "off"
			}
		}
	},
  "html": {
    "parser": {
      "interpolation": true
    }
  }
}
